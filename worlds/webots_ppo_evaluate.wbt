WorldInfo { basicTimeStep 32 title "Indoor Patrol Robot - Webots PPO Evaluation" }
Viewpoint { orientation -0.363 0.858 0.363 1.72 position 2.8 -3.1 2.7 follow "PatrolRobot" followType "Pan and Tilt Shot" }
