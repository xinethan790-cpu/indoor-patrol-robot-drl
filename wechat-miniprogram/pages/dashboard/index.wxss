.dashboard-page {
  min-height: 100vh;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 30rpx 44rpx;
  background: linear-gradient(145deg, #061a2b 0%, #0b2f4d 63%, #08496a 100%);
  color: #ffffff;
}

.hero__glow {
  position: absolute;
  border-radius: 50%;
  opacity: 0.18;
  filter: blur(2rpx);
}

.hero__glow--one {
  top: -150rpx;
  right: -90rpx;
  width: 380rpx;
  height: 380rpx;
  background: #0ed5ff;
}

.hero__glow--two {
  bottom: -160rpx;
  left: 150rpx;
  width: 330rpx;
  height: 330rpx;
  background: #127cff;
}

.hero__topline,
.connection,
.hero__metrics {
  position: relative;
  z-index: 1;
}

.hero__topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero__eyebrow,
.hero__title {
  display: block;
}

.hero__eyebrow {
  margin-bottom: 9rpx;
  color: #78c9ee;
  font-size: 19rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.hero__title {
  font-size: 43rpx;
  font-weight: 720;
  letter-spacing: 2rpx;
}

.hero__mode {
  margin-top: 5rpx;
  padding: 10rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.09);
  color: #d9f4ff;
  font-size: 20rpx;
  font-weight: 650;
}

.hero__mode--live {
  background: rgba(0, 218, 154, 0.16);
  color: #87f4d0;
}

.connection {
  display: flex;
  align-items: center;
  margin-top: 23rpx;
  color: #b9d1df;
  font-size: 22rpx;
}

.connection__dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 11rpx;
  border-radius: 50%;
  background: #7890a2;
  box-shadow: 0 0 0 7rpx rgba(120, 144, 162, 0.13);
}

.connection__dot--online {
  background: #27dda3;
  box-shadow: 0 0 0 7rpx rgba(39, 221, 163, 0.13);
}

.connection__dot--warning {
  background: #ffc765;
  box-shadow: 0 0 0 7rpx rgba(255, 199, 101, 0.13);
}

.connection__dot--offline {
  background: #ff7180;
  box-shadow: 0 0 0 7rpx rgba(255, 113, 128, 0.13);
}

.connection__identity {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-left: auto;
}

.connection__sequence {
  margin-right: 10rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(98, 194, 235, 0.1);
  color: #76c8eb;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 17rpx;
}

.connection__run {
  display: block;
  max-width: 270rpx;
  overflow: hidden;
  color: #7f9eb2;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero__metrics {
  display: flex;
  margin-top: 36rpx;
  padding: 23rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 23rpx;
  background: rgba(4, 20, 34, 0.28);
  backdrop-filter: blur(14rpx);
}

.hero-metric {
  flex: 1;
  text-align: center;
}

.hero-metric--middle {
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
  border-left: 1rpx solid rgba(255, 255, 255, 0.1);
}

.hero-metric__value,
.hero-metric__label {
  display: block;
}

.hero-metric__value {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.hero-metric__label {
  margin-top: 5rpx;
  color: #87a6b9;
  font-size: 20rpx;
}

.content {
  margin-top: -18rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #f2f6fa;
}

.error-banner {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #ffd2d7;
  border-radius: 20rpx;
  background: #fff0f2;
}

.error-banner__title,
.error-banner__message {
  display: block;
}

.cloud-sync {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #cfe2f3;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #edf7ff, #f1fbf8);
}

.cloud-sync__icon {
  display: flex;
  flex: 0 0 52rpx;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 15rpx;
  border-radius: 16rpx;
  background: #0878f9;
  color: #ffffff;
  font-size: 27rpx;
}

.cloud-sync__body {
  min-width: 0;
}

.cloud-sync__title,
.cloud-sync__text,
.cloud-sync__time {
  display: block;
}

.cloud-sync__title {
  color: #244c69;
  font-size: 22rpx;
  font-weight: 680;
}

.cloud-sync__text {
  margin-top: 4rpx;
  overflow: hidden;
  color: #748c9e;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cloud-sync__time {
  margin-top: 3rpx;
  color: #90a2b0;
  font-size: 17rpx;
}

.cloud-sync__transport {
  flex: 0 0 auto;
  margin-left: auto;
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  background: rgba(8, 120, 249, 0.09);
  color: #0878f9;
  font-size: 18rpx;
  font-weight: 650;
}

.error-banner__title {
  color: #b72c3d;
  font-weight: 650;
}

.error-banner__message {
  margin-top: 5rpx;
  color: #a75761;
  font-size: 22rpx;
}

.map-card {
  padding-bottom: 20rpx;
}

.map-card__sub,
.sensor-section__source {
  display: block;
  margin-top: 5rpx;
  color: #8190a1;
  font-size: 21rpx;
}

.map-legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx 26rpx;
  margin-top: 14rpx;
  color: #758597;
  font-size: 20rpx;
}

.map-legend__item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.legend-dot--robot {
  background: #00c9ff;
  box-shadow: 0 0 0 5rpx rgba(0, 201, 255, 0.15);
}

.legend-dot--dynamic {
  border: 2rpx solid #ff9f43;
  background: rgba(255, 159, 67, 0.24);
  box-shadow: 0 0 0 4rpx rgba(255, 159, 67, 0.1);
}

.legend-dot--done {
  background: #20bd82;
}

.legend-dot--pending {
  border: 2rpx solid #8ea2b3;
  background: #ffffff;
}

.demo-presentation {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #d7e5f0;
  border-radius: 24rpx;
  background: #ffffff;
}

.demo-event {
  padding: 19rpx 20rpx;
  border-left: 6rpx solid #2c9bd6;
  border-radius: 17rpx;
  background: #eef8fd;
}

.demo-event--guard {
  border-left-color: #7952be;
  background: #f3effc;
}

.demo-event--warning {
  border-left-color: #d28a12;
  background: #fff7e8;
}

.demo-event--critical {
  border-left-color: #d94655;
  background: #fff0f2;
}

.demo-event--success {
  border-left-color: #168d63;
  background: #ebf9f3;
}

.demo-event__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.demo-event__label,
.demo-event__description {
  display: block;
}

.demo-event__label {
  color: #183b57;
  font-size: 27rpx;
  font-weight: 700;
}

.demo-event__position {
  margin-left: 16rpx;
  color: #52738b;
  font-size: 21rpx;
  white-space: nowrap;
}

.demo-event__description {
  margin-top: 8rpx;
  color: #597084;
  font-size: 22rpx;
  line-height: 1.55;
}

.demo-controls {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.avoidance-card {
  overflow: hidden;
  border-top: 5rpx solid #20bd82;
}

.avoidance-card--warning {
  border-top-color: #f0a42c;
}

.avoidance-card--critical {
  border-top-color: #e54a58;
}

.avoidance-card--guard {
  border-top-color: #8a63d2;
}

.avoidance-card--idle {
  border-top-color: #9aa9b7;
}

.avoidance-card__sub,
.avoidance-card__summary {
  display: block;
}

.avoidance-card__sub {
  margin-top: 5rpx;
  color: #8190a1;
  font-size: 20rpx;
}

.avoidance-card__summary {
  margin: 7rpx 0 21rpx;
  color: #687b8e;
  font-size: 21rpx;
  line-height: 1.55;
}

.avoidance-status {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e9f8f2;
  color: #16805a;
  font-size: 19rpx;
  font-weight: 680;
}

.avoidance-status--warning {
  background: #fff4df;
  color: #a26300;
}

.avoidance-status--critical {
  background: #ffeaed;
  color: #bd3443;
}

.avoidance-status--guard {
  background: #f1ebff;
  color: #6740aa;
}

.avoidance-status--idle {
  background: #edf1f4;
  color: #728292;
}

.avoidance-metrics {
  display: flex;
  padding: 18rpx 0;
  border-radius: 19rpx;
  background: #f3f7fa;
}

.avoidance-metric {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.avoidance-metric + .avoidance-metric {
  border-left: 1rpx solid #dce5ec;
}

.avoidance-metric__value,
.avoidance-metric__label {
  display: block;
}

.avoidance-metric__value {
  overflow: hidden;
  color: #17314b;
  font-size: 24rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avoidance-metric__label {
  margin-top: 5rpx;
  color: #8a99a7;
  font-size: 18rpx;
}

.decision-flow {
  margin-top: 18rpx;
}

.decision-step {
  padding: 17rpx 19rpx;
  border: 1rpx solid #dce7ef;
  border-radius: 17rpx;
  background: #f8fafc;
}

.decision-step--filtered {
  border-color: #d4e6f7;
  background: #f0f7fd;
}

.decision-step--executed {
  border-color: #caeadf;
  background: #f0faf6;
}

.decision-step__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.decision-step__label,
.decision-step__value {
  display: block;
}

.decision-step__label {
  color: #7d8c9b;
  font-size: 18rpx;
}

.decision-step__value {
  margin-top: 5rpx;
  color: #263f57;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 22rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.decision-step__badge {
  padding: 4rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(8, 120, 249, 0.09);
  color: #0878f9;
  font-size: 16rpx;
}

.decision-step__badge--guard {
  background: rgba(103, 64, 170, 0.09);
  color: #6740aa;
}

.decision-flow__arrow {
  display: block;
  height: 29rpx;
  color: #9babb8;
  font-size: 22rpx;
  line-height: 29rpx;
  text-align: center;
}

.demo-controls__main {
  flex: 1;
}

.demo-controls__next {
  flex: 1;
}

.demo-controls__next--disabled {
  color: #9caab6;
  background: #edf1f4;
}

.demo-options,
.demo-speed {
  display: flex;
  align-items: center;
}

.demo-options {
  justify-content: space-between;
  margin-top: 16rpx;
}

.demo-speed__label {
  margin-right: 10rpx;
  color: #61788c;
  font-size: 22rpx;
}

.demo-speed__button,
.demo-reset {
  height: 58rpx;
  margin: 0 0 0 8rpx;
  padding: 0 20rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
  line-height: 58rpx;
}

.demo-speed__button {
  background: #edf3f8;
  color: #526b80;
}

.demo-speed__button--active {
  background: #0878f9;
  color: #ffffff;
}

.demo-reset {
  background: transparent;
  color: #39647f;
}

.progress-track {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6eef5;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0a78f5, #18c6c3);
  transition: width 240ms ease;
}

.checkpoint-row {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.checkpoint {
  width: 24%;
  text-align: center;
}

.checkpoint__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto;
  border: 2rpx solid #c2ced9;
  border-radius: 50%;
  background: #f5f8fa;
  color: #718397;
  font-size: 22rpx;
  font-weight: 700;
}

.checkpoint--completed .checkpoint__mark {
  border-color: #20bd82;
  background: #20bd82;
  color: #ffffff;
}

.checkpoint--current .checkpoint__mark {
  border-color: #0878f9;
  background: #e4f1ff;
  color: #0878f9;
  box-shadow: 0 0 0 7rpx rgba(8, 120, 249, 0.09);
}

.checkpoint__name,
.checkpoint__status {
  display: block;
}

.checkpoint__name {
  margin-top: 9rpx;
  color: #334c64;
  font-size: 23rpx;
  font-weight: 650;
}

.checkpoint__status {
  margin-top: 2rpx;
  color: #96a2af;
  font-size: 18rpx;
}

.sensor-grid {
  display: flex;
  gap: 12rpx;
}

.sensor-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx 16rpx;
  border-radius: 22rpx;
  background: #f4f8fc;
}

.sensor-card--warm {
  background: #fff6ed;
}

.sensor-card--cool {
  background: #edf7ff;
}

.sensor-card--mint {
  background: #eef9f5;
}

.sensor-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
}

.sensor-card__name,
.sensor-card__state {
  display: block;
}

.sensor-card__name {
  margin-top: 15rpx;
  overflow: hidden;
  color: #708092;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sensor-card__reading {
  display: flex;
  align-items: baseline;
  margin-top: 5rpx;
}

.sensor-card__value {
  color: #17314b;
  font-size: 35rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
}

.sensor-card__unit {
  margin-left: 3rpx;
  color: #8190a1;
  font-size: 17rpx;
}

.sensor-card__state {
  margin-top: 8rpx;
  color: #8a98a7;
  font-size: 18rpx;
}

.alarm-clear {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #edf9f4;
}

.alarm-clear__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-right: 17rpx;
  border-radius: 50%;
  background: #20bd82;
  color: #ffffff;
  font-weight: 800;
}

.alarm-clear__title,
.alarm-clear__text {
  display: block;
}

.alarm-clear__title {
  color: #176344;
  font-weight: 650;
}

.alarm-clear__text {
  margin-top: 4rpx;
  color: #6c9684;
  font-size: 21rpx;
}

.active-alarm {
  margin-bottom: 13rpx;
  padding: 20rpx;
  border-left: 6rpx solid #efaf39;
  border-radius: 16rpx;
  background: #fff8e9;
}

.active-alarm--critical {
  border-left-color: #e54a58;
  background: #fff0f2;
}

.active-alarm__top {
  display: flex;
  justify-content: space-between;
}

.active-alarm__title {
  color: #24384b;
  font-weight: 650;
}

.active-alarm__point,
.active-alarm__message,
.active-alarm__value {
  color: #7b5e61;
  font-size: 21rpx;
}

.active-alarm__message,
.active-alarm__value {
  display: block;
  margin-top: 7rpx;
}

.alarm-link {
  min-height: 72rpx;
  height: 72rpx;
  margin-top: 13rpx;
  padding: 0;
  background: transparent;
  color: #0878f9;
  font-size: 23rpx;
  line-height: 72rpx;
  text-align: left;
}

.result-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 27rpx;
  background: linear-gradient(135deg, #66788a, #8393a3);
  color: #ffffff;
  line-height: 1.2;
  text-align: left;
  box-shadow: 0 12rpx 30rpx rgba(13, 121, 87, 0.18);
}

.result-banner::after {
  border: 0;
}

.result-banner--success {
  background: linear-gradient(135deg, #0d7957, #13aa77);
  box-shadow: 0 12rpx 30rpx rgba(13, 121, 87, 0.18);
}

.result-banner--failure {
  background: linear-gradient(135deg, #a92f3b, #d85861);
  box-shadow: 0 12rpx 30rpx rgba(169, 47, 59, 0.2);
}

.result-banner__eyebrow,
.result-banner__title,
.result-banner__text {
  display: block;
}

.result-banner__eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.result-banner__title {
  margin-top: 7rpx;
  font-size: 31rpx;
  font-weight: 720;
}

.result-banner__text {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 21rpx;
}

.result-banner__arrow {
  font-size: 55rpx;
  font-weight: 200;
}

.mode-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: #e9f1f8;
}

.mode-switch--pressed {
  background: #dbe9f5;
  transform: scale(0.99);
}

.mode-switch__title,
.mode-switch__text {
  display: block;
}

.mode-switch__title {
  color: #31506b;
  font-weight: 650;
}

.mode-switch__text {
  max-width: 510rpx;
  margin-top: 4rpx;
  color: #778b9c;
  font-size: 20rpx;
}

.mode-switch__action {
  color: #0878f9;
  font-size: 23rpx;
  font-weight: 650;
}

.boundary-note {
  display: block;
  padding: 6rpx 20rpx 18rpx;
  color: #9aa6b2;
  font-size: 19rpx;
  line-height: 1.6;
  text-align: center;
}
