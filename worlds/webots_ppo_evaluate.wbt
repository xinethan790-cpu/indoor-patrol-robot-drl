TexturedBackgroundLight { }
RectangleArena { floorSize 4.5 3.5 wallHeight 0.3 }
DEF PATROL_GOAL Pose {
  translation 1.55 0 0.025
  children [ Shape { appearance PBRAppearance { baseColor 0.1 0.8 0.25 emissiveColor 0.03 0.25 0.08 roughness 0.5 metalness 0 } geometry Cylinder { height 0.05 radius 0.22 } } ]
}
