:host {
  display: block;
  width: 100%;
}

.patrol-map-shell {
  position: relative;
  width: 100%;
  height: 520rpx;
  min-height: 260px;
  max-height: 430px;
  overflow: hidden;
  border: 1rpx solid rgba(62, 216, 255, 0.22);
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 50% 42%, rgba(20, 104, 145, 0.18), transparent 58%),
    linear-gradient(145deg, #071625 0%, #04101d 100%);
  box-shadow:
    inset 0 0 36rpx rgba(17, 110, 150, 0.10),
    0 16rpx 44rpx rgba(0, 9, 18, 0.28);
  box-sizing: border-box;
}

.patrol-map-shell--compact {
  height: 360rpx;
  min-height: 180px;
  max-height: 280px;
  border-radius: 18rpx;
}

.patrol-map-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.patrol-map-empty {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.patrol-map-empty__radar {
  width: 92rpx;
  height: 92rpx;
  border: 2rpx solid rgba(63, 220, 255, 0.45);
  border-radius: 50%;
  background:
    radial-gradient(circle, #50e7ff 0 5rpx, transparent 6rpx),
    linear-gradient(90deg, transparent 49%, rgba(63, 220, 255, 0.20) 50%, transparent 51%),
    linear-gradient(transparent 49%, rgba(63, 220, 255, 0.20) 50%, transparent 51%);
  box-shadow: 0 0 30rpx rgba(58, 217, 255, 0.20);
}

.patrol-map-empty__text {
  margin-top: 24rpx;
  color: rgba(190, 218, 231, 0.68);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
