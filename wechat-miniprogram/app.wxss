page {
  min-height: 100%;
  background: #f2f6fa;
  color: #17283c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
scroll-view,
canvas {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page-shell {
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

.section-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(28, 76, 120, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 34rpx rgba(19, 55, 91, 0.06);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  color: #12263d;
  font-size: 32rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.section-caption {
  color: #8190a1;
  font-size: 22rpx;
}

.empty-state {
  padding: 36rpx 20rpx;
  color: #8190a1;
  text-align: center;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-button {
  background: linear-gradient(135deg, #0878f9, #05a8e9);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(8, 120, 249, 0.2);
}

.secondary-button {
  background: #edf4fb;
  color: #285174;
}

.primary-button.button-hover,
.secondary-button.button-hover {
  opacity: 0.84;
  transform: scale(0.985);
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf4fb;
  color: #35607f;
  font-size: 21rpx;
  font-weight: 600;
}

.tag--success {
  background: #e5f8ef;
  color: #08794d;
}

.tag--active {
  background: #e7f2ff;
  color: #086dcc;
}

.tag--failure {
  background: #ffebed;
  color: #b82f3b;
}

.tag--waiting {
  background: #eef2f6;
  color: #66788a;
}

.tag--warning {
  background: #fff3d9;
  color: #9d6000;
}

.tag--critical {
  background: #ffebed;
  color: #bf3340;
}
